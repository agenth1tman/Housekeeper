<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\Housekeeper.ico</ApplicationIcon>
    <AssemblyName>Housekeeper</AssemblyName>
    <RootNamespace>Housekeeper</RootNamespace>
    <Product>Housekeeper</Product>
    <Company>agenth1tman</Company>
    <Authors>agenth1tman</Authors>
    <Version>2.0.0</Version>
    <Copyright>© 2026 agenth1tman</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The UI is built in code, not in the designer, so designer serialization hints don't apply. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fonts and icon are built into the exe, so a missing file can never stop the app from opening. -->
    <EmbeddedResource Include="Assets\Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Housekeeper.ico" LogicalName="Housekeeper.ico" />
    <None Include="LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- The SIL Open Font License asks for the licence to travel with the font. -->
    <None Include="Assets\Fonts\OFL.txt" Link="Licenses\Montserrat-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Made by sandbox test runs; not part of the app. -->
    <Compile Remove="sandbox\**" />
    <None Remove="sandbox\**" />
    <EmbeddedResource Remove="sandbox\**" />
  </ItemGroup>

</Project>
